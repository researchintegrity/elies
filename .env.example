# Environment Configuration
# Copy this file to .env and update the values for your environment.
# docker compose passes this file to the API and worker containers.

# ============================================================================
# REQUIRED
# ============================================================================

# JWT signing secret. The API refuses to start without a secret of at least
# 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone who knows this value can sign in as any user: keep it private.
JWT_SECRET=

# Absolute path of the workspace directory on the host (uploaded PDFs, images,
# analysis results). Used for Docker volume mounts by the API, workers and tools.
# Example on Linux/Mac: /home/username/projects/elies/system_modules/elies-frontend/workspace
# Example on Windows: C:/Users/username/projects/elies/system_modules/elies-frontend/workspace
# NOTE: On Windows, use forward slashes (/) or escaped backslashes (\\) for Docker compatibility
HOST_WORKSPACE_PATH=/path/to/your/elies/system_modules/elies-frontend/workspace
# Where the workspace is mounted inside the API/worker containers
CONTAINER_WORKSPACE_PATH=/container-workspace

# ============================================================================
# NETWORK EXPOSURE
# ============================================================================

# Interface the API is published on (0.0.0.0 = all interfaces)
API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
# Interface for internal services (MongoDB, Redis, Flower, MinIO, Milvus, Attu,
# CBIR, provenance). Keep 127.0.0.1 so they are not reachable from the network.
BIND_ADDRESS=127.0.0.1

# Behind a reverse proxy on the same host (API_BIND_ADDRESS=127.0.0.1), set
# FORWARDED_ALLOW_IPS=* so the API takes client addresses from the proxy's
# X-Forwarded-For header. Otherwise every request appears to come from the
# Docker gateway, and the per-IP login and registration limits become a
# single limit shared by all users. Leave unset when the API port is exposed
# directly, or clients could forge their address.
# FORWARDED_ALLOW_IPS=*

# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================================
# DATABASE
# ============================================================================

# For local development: mongodb://localhost:27017
# For Docker: mongodb://mongo:27017
# With authentication: mongodb://<user>:<password>@mongo:27017/?authSource=admin
MONGODB_URL=mongodb://mongo:27017
# Deployments created before the ELIS -> ELIES rename: use elis_system to keep existing data
DATABASE_NAME=elies_system
MONGODB_PORT=27017
# Optional MongoDB root user, applied only when the data volume is first created.
# If you set these, include the credentials in MONGODB_URL as shown above.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ============================================================================
# REDIS / CELERY
# ============================================================================

# For local development: localhost. For Docker: redis
REDIS_HOST=redis
REDIS_PORT=6379
# Recommended: require a password for the Celery broker
REDIS_PASSWORD=
# Optional: full broker/result URLs (default: built from the REDIS_* values above)
# CELERY_BROKER_URL=redis://:password@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:password@redis:6379/1

# Number of tasks each worker processes in parallel (docker-compose-prod.yml)
WORKER_CONCURRENCY=3
FLOWER_PORT=5555

# ============================================================================
# AUTHENTICATION
# ============================================================================

JWT_EXPIRATION_HOURS=24

# ============================================================================
# STORAGE LIMITS
# ============================================================================

DEFAULT_USER_STORAGE_QUOTA_GB=1
PDF_MAX_SIZE_MB=500
IMAGE_MAX_SIZE_MB=100
# Largest image accepted (width * height), protects against decompression bombs
MAX_IMAGE_PIXELS=200000000
MAX_BATCH_UPLOAD_FILES=200

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
# "text" (default) or "json" (one JSON object per line, for log collectors)
LOG_FORMAT=text

# ============================================================================
# MICROSERVICES
# ============================================================================

# CBIR Service (use the container name in Docker)
CBIR_SERVICE_HOST=cbir-service
CBIR_SERVICE_PORT=8001

# Provenance Service (use the container name in Docker)
PROVENANCE_SERVICE_HOST=provenance-service
PROVENANCE_SERVICE_PORT=8002

# TruFor: set to true only on hosts with an NVIDIA GPU and runtime
TRUFOR_USE_GPU=false

# Forgeryscope copy-move detection: set to true only on hosts with an NVIDIA
# GPU and runtime, with the forgeryscope image built with CUDA wheels
FORGERYSCOPE_USE_GPU=false

# Milvus Vector Database
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ATTU_PORT=3322

# MinIO Object Storage (used by Milvus)
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9010
