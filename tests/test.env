# Test environment defaults (loaded by tests/conftest.py without overriding real env vars).
#
# DATABASE_NAME, HOST_WORKSPACE_PATH and CONTAINER_WORKSPACE_PATH are set by
# tests/conftest.py itself: tests always use a throw-away "elies_test_*" database
# and a temporary workspace directory, never real data.

MONGODB_URL=mongodb://localhost:27017

# Test-only signing key (never use in a deployment)
JWT_SECRET=test-only-jwt-secret-0123456789abcdef0123456789abcdef
JWT_EXPIRATION_HOURS=24

REDIS_HOST=localhost
REDIS_PORT=6379

CBIR_SERVICE_HOST=localhost
CBIR_SERVICE_PORT=8001
PROVENANCE_SERVICE_HOST=localhost
PROVENANCE_SERVICE_PORT=8002

TRUFOR_USE_GPU=false
LOG_LEVEL=INFO

# Cheap password hashing for fast tests (never lower this in a deployment)
BCRYPT_ROUNDS=4
